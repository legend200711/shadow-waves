{
  "projects": {
    "default": "shadow-nexus-wave"
  },
  "firestore": {
    "rules": "firestore-wave.rules",
    "indexes": "firestore-wave.indexes.json"
  },
  "database": {
    "rules": "database-wave.rules.json"
  },
  "storage": {
    "rules": "storage-wave.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase-wave.json",
      "firestore-wave.rules",
      "firestore-wave.indexes.json",
      "database-wave.rules.json",
      "storage-wave.rules",
      ".firebaserc",
      ".git/**",
      ".idea/**",
      ".wrangler/**",
      "node_modules/**",
      "generate_icons.py",
      "generate_icons_snw.py",
      "wrangler-wave.jsonc",
      "cors.json",
      "package.json",
      "package-lock.json",
      "WAVE_SETUP.md",
      "_archive/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.@(js|mjs|html|css|png|jpg|webp|svg|ico|json|woff2)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ]
  }
}
